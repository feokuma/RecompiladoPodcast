---
const { pathname } = Astro.url;
const nav = [
  { href: "/", label: "Início" },
  { href: "/episodios/", label: "Episódios" },
  { href: "/sobre/", label: "Sobre" },
];

const isCurrent = (href: string): boolean =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header class="site-header">
  <div class="site-header__inner">
    <a href="/" class="site-header__brand" aria-label="Recompilado Podcast — Início">
      <img
        src="/brand/icone-verde-fundo-escuro.png"
        alt=""
        width="48"
        height="48"
        class="site-header__logo"
        loading="eager"
      />
      <span class="site-header__name">Recompilado Podcast</span>
    </a>
    <nav class="site-header__nav" aria-label="Navegação principal">
      {nav.map((item) => (
        <a
          href={item.href}
          class="site-header__link"
          aria-current={isCurrent(item.href) ? "page" : undefined}
        >
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    width: 100%;
    background-color: var(--color-bg);
    border-bottom: 1px solid var(--color-border-subtle);
  }

  .site-header__inner {
    width: 100%;
    max-width: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: 0 var(--space-5);
    min-height: 72px;
  }

  .site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    color: var(--color-text);
  }

  .site-header__logo {
    width: 48px;
    height: 48px;
    flex-shrink: 0;
  }

  .site-header__name {
    font-size: 1.45rem;
    font-weight: 700;
    letter-spacing: -0.01em;
  }

  .site-header__nav {
    display: flex;
    gap: var(--space-6);
  }

  .site-header__link {
    color: var(--color-text-muted);
    font-size: 1.05rem;
  }

  .site-header__link:hover {
    color: var(--color-green);
  }

  .site-header__link[aria-current="page"] {
    color: var(--color-green);
  }

  @media (max-width: 560px) {
    .site-header__name {
      display: none;
    }

    .site-header__nav {
      gap: var(--space-4);
    }
  }
</style>