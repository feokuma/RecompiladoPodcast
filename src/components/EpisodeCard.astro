---
import type { Episode } from "../data/episodes";
import { episodePath } from "../data/episodes";

interface Props {
  episode: Episode;
}

const { episode } = Astro.props;
const { numeroLabel, categoria, titulo, descricao, convidados, capa } = episode;
---

<a href={episodePath(episode)} class="episode-card">
  <div class="episode-card__media">
    <img src={capa} alt="" width="512" height="512" loading="lazy" class="episode-card__img" />
  </div>
  <div class="episode-card__body">
    <p class="label">
      {numeroLabel} · {categoria}
    </p>
    <h3 class="episode-card__title">{titulo}</h3>
    <p class="episode-card__desc">{descricao}</p>
    {
      convidados.length > 0 && (
        <p class="episode-card__guests">
          <span class="sr-only">Convidados: </span>
          {convidados.join(", ")}
        </p>
      )
    }
  </div>
</a>

<style>
  .episode-card {
    display: block;
    background-color: var(--color-bg-elevated);
    border: 1px solid var(--color-border-subtle);
    border-radius: var(--radius-lg);
    overflow: hidden;
    color: var(--color-text);
    transition: border-color 0.15s ease, transform 0.15s ease;
  }

  .episode-card:hover {
    border-color: var(--color-green);
    color: var(--color-text);
    transform: translateY(-2px);
  }

  .episode-card__media {
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .episode-card__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .episode-card__body {
    padding: var(--space-4) var(--space-5) var(--space-5);
  }

  .episode-card__title {
    font-size: 1.2rem;
    margin: var(--space-2) 0 var(--space-2);
  }

  .episode-card__desc {
    color: var(--color-text-muted);
    font-size: 0.94rem;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .episode-card__guests {
    color: var(--color-green);
    font-size: 0.9rem;
    margin: var(--space-3) 0 0;
  }
</style>